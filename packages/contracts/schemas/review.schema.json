{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opsreplay.local/schemas/review.schema.json",
  "title": "OpsReplay Code Review bundle",
  "description": "Proposed v0.2 private bundle. The API returns the exercise projection before submission and findings only after it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "0.2"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 30,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"]
    },
    "tier": {
      "type": "string",
      "enum": ["easy", "medium", "hard"]
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "plan": {
      "type": "string",
      "enum": ["free", "pro"]
    },
    "language": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["synthetic", "adapted"]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "mechanism": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": ["title", "url", "mechanism"]
          },
          "maxItems": 20
        }
      },
      "required": ["kind", "notes", "sources"]
    },
    "relatedChallenges": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "maxItems": 10
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["context", "added", "removed"]
                },
                "oldLine": {
                  "type": ["integer", "null"],
                  "minimum": 1,
                  "maximum": 100000
                },
                "newLine": {
                  "type": ["integer", "null"],
                  "minimum": 1,
                  "maximum": 100000
                },
                "text": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 2000
                }
              },
              "required": ["kind", "oldLine", "newLine", "text"]
            },
            "maxItems": 2000,
            "minItems": 1
          }
        },
        "required": ["path", "lines"]
      },
      "maxItems": 20,
      "minItems": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "side": {
            "type": "string",
            "enum": ["old", "new"]
          },
          "startLine": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "endLine": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          }
        },
        "required": ["id", "title", "explanation", "file", "side", "startLine", "endLine"]
      },
      "maxItems": 50,
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "summary",
    "status",
    "tier",
    "category",
    "plan",
    "language",
    "context",
    "provenance",
    "relatedChallenges",
    "files",
    "findings"
  ]
}
