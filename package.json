{
  "name": "opsreplay",
  "version": "0.0.0",
  "private": true,
  "description": "OpsReplay specification and implementation workspace",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "lint": "oxlint . --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint . --fix --deny-warnings --report-unused-disable-directives",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "quality": "npm run lint && npm run format:check && npm run typecheck",
    "monitor:test": "node --import tsx --test apps/monitor/test/*.test.ts",
    "monitor:build": "node scripts/build-monitor.mjs",
    "monitor:image:build": "docker build --target test -t opsreplay/monitor-test:dev -f apps/monitor/Dockerfile .",
    "monitor:image:test": "node --test apps/monitor/test/image.test.mjs",
    "gateway:build": "node scripts/build-gateway.mjs",
    "gateway:test": "npm run gateway:build && node --import tsx --test apps/gateway/test/*.test.ts",
    "gateway:image:test": "npm run gateway:build && node --test apps/gateway/test/image.test.mjs",
    "gateway:runtime:image:build": "docker build --platform linux/amd64 --target runtime -t opsreplay/gateway-recording:dev -f apps/gateway/Dockerfile .",
    "gateway:runtime:image:test": "node --test apps/gateway/test/runtime-image.test.mjs",
    "challenge:build": "docker build -t opsreplay/challenge-wrong-upstream-port:dev content/challenges/wrong-upstream-port/image",
    "challenge:test": "node --test content/challenges/wrong-upstream-port/image.test.mjs",
    "check": "node scripts/check.mjs && node --import tsx --test packages/contracts/private/*.test.ts && node --test scripts/*.test.mjs",
    "contracts:sync": "node scripts/sync-openapi.mjs && prettier --write packages/contracts/openapi.json",
    "typecheck": "tsc --noEmit",
    "api:build": "node scripts/build-start-session.mjs",
    "api:test": "npm run api:build && node --import tsx --test apps/api/test/*.test.ts",
    "infra:test": "npm run api:build && node --import tsx --test infra/*.test.ts",
    "infra:synth": "npm run api:build && node --import tsx infra/synth.ts"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "aws-cdk-lib": "2.272.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1146.0",
    "@aws-sdk/client-ecs": "3.1146.0",
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/client-scheduler": "3.1146.0",
    "@aws-sdk/lib-dynamodb": "3.1146.0",
    "@smithy/node-http-handler": "4.12.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "selfsigned": "5.5.0"
  }
}
