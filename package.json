{
  "name": "opsreplay",
  "version": "0.0.0",
  "private": true,
  "description": "OpsReplay specification and implementation workspace",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "lint": "oxlint . --deny-warnings --report-unused-disable-directives && oxlint apps/web/src --react-plugin --allow all --deny react/rules-of-hooks --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings --report-unused-disable-directives",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "quality": "npm run lint && npm run format:check && npm run typecheck",
    "monitor:test": "node --import tsx --test apps/monitor/test/*.test.ts",
    "monitor:build": "node scripts/build-monitor.mjs",
    "monitor:image:build": "docker build --target test -t opsreplay/monitor-test:dev -f apps/monitor/Dockerfile .",
    "monitor:image:test": "node --import tsx --test apps/monitor/test/image.test.mjs",
    "monitor:reference:image:build": "docker build --platform linux/amd64 --provenance=false --target reference -t opsreplay/monitor-reference:dev -f apps/monitor/Dockerfile .",
    "monitor:reference:image:test": "OPSREPLAY_MONITOR_IMAGE=opsreplay/monitor-reference:dev OPSREPLAY_MONITOR_CLIENT_IMAGE=opsreplay/monitor-test:dev npm run monitor:image:test",
    "monitor:runtime:image:build": "docker build --platform linux/amd64 --provenance=false --target runtime -t opsreplay/monitor:dev -f apps/monitor/Dockerfile .",
    "gateway:build": "node scripts/build-gateway.mjs",
    "gateway:test": "npm run gateway:build && node --import tsx --test apps/gateway/test/*.test.ts",
    "gateway:image:test": "npm run gateway:build && node --test apps/gateway/test/image.test.mjs",
    "gateway:runtime:image:build": "docker build --platform linux/amd64 --provenance=false --target runtime -t opsreplay/gateway-recording:dev -f apps/gateway/Dockerfile .",
    "gateway:runtime:image:test": "node --test apps/gateway/test/runtime-image.test.mjs",
    "challenge:build": "docker build --platform linux/amd64 --provenance=false -t opsreplay/challenge-wrong-upstream-port:dev content/challenges/wrong-upstream-port/image",
    "challenge:test": "node --import tsx --test content/challenges/wrong-upstream-port/image.test.mjs content/challenges/wrong-upstream-port/recording-wire.test.mjs content/challenges/wrong-upstream-port/proposals-wire.test.mjs",
    "check": "node scripts/check.mjs && node --import tsx --test packages/contracts/private/*.test.ts && node --test scripts/*.test.mjs",
    "contracts:sync": "node scripts/sync-openapi.mjs && prettier --write packages/contracts/openapi.json",
    "typecheck": "npm run contracts:check && tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.test.json",
    "content:test": "node --import tsx --test packages/content/test/*.test.ts",
    "content:publish": "node --import tsx scripts/publish-reference-release.ts",
    "api:build": "node scripts/build-start-session.mjs",
    "api:test": "npm run api:build && node --import tsx --test apps/api/test/*.test.ts",
    "infra:test": "npm run api:build && node --import tsx --test infra/*.test.ts",
    "infra:synth": "npm run api:build && node --import tsx infra/synth.ts",
    "infra:cdk": "cdk",
    "contracts:generate": "node scripts/generate-public-contracts.mjs",
    "contracts:check": "node scripts/generate-public-contracts.mjs --check",
    "web:dev": "npm run learn:build && npm run contracts:check && vite --config apps/web/vite.config.ts",
    "web:build": "npm run learn:build && npm run contracts:check && vite build --config apps/web/vite.config.ts",
    "web:test": "npm run contracts:check && node --import tsx --test apps/web/test/*.test.ts",
    "challenge:dns:build": "node scripts/build-dns-challenge.mjs",
    "challenge:dns:test": "node --import tsx --test content/challenges/stale-dns-record/image.test.mjs",
    "monitor:dns:image:build": "docker build --platform linux/amd64 --provenance=false --target stale-dns -t opsreplay/monitor-stale-dns:dev -f apps/monitor/Dockerfile .",
    "monitor:dns:image:test": "OPSREPLAY_TEST_CHALLENGE=stale-dns-record OPSREPLAY_CHALLENGE_IMAGE=opsreplay/challenge-stale-dns-record:dev OPSREPLAY_MONITOR_IMAGE=opsreplay/monitor-stale-dns:dev OPSREPLAY_MONITOR_CLIENT_IMAGE=opsreplay/monitor-test:dev node --import tsx --test apps/monitor/test/image.test.mjs",
    "learn:build": "node --import tsx scripts/build-learn.mjs",
    "learn:publish": "node --import tsx scripts/publish-learn.ts",
    "review:publish": "node --import tsx scripts/publish-review.ts",
    "history:backfill": "node --import tsx scripts/backfill-history.ts",
    "evaluation:scenarios": "node --import tsx scripts/evaluation/main.ts scenarios",
    "evaluation:load": "node --import tsx scripts/evaluation/main.ts load",
    "evaluation:assistant": "node --import tsx scripts/evaluation/main.ts assistant",
    "evaluation:test": "node --import tsx --test scripts/evaluation/*.test.ts"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@mantine/core": "9.7.2",
    "@mantine/hooks": "9.7.2",
    "@types/aws-lambda": "8.10.164",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/ws": "8.18.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "aws-cdk": "2.1145.0",
    "aws-cdk-lib": "2.272.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "json-schema-to-typescript": "16.0.0",
    "oidc-client-ts": "3.5.0",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1146.0",
    "@aws-sdk/client-ecs": "3.1146.0",
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/client-scheduler": "3.1146.0",
    "@aws-sdk/client-secrets-manager": "3.1146.0",
    "@aws-sdk/lib-dynamodb": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@smithy/node-http-handler": "4.12.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "markdown-it": "15.0.3",
    "sanitize-html": "2.18.1",
    "selfsigned": "5.5.0",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  }
}
